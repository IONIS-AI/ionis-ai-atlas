  "info": {
    "description": "Read-only access to the published IONIS-AI collection. Every field is defined by ADIF 3.1.7 or by the IONIS-AI extension (ionis-core docs/IONIS-DATA-SPEC.md). This description is a published contract: /api/v1 changes are additive only.",
    "title": "IONIS-AI Atlas API",
    "version": "dev"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/adif/bands": {
      "get": {
        "description": "ADIF's Band enumeration: name and frequency range in MHz, in frequency order.",
        "operationId": "bands_api_v1_adif_bands_get",
        "parameters": [
          {
            "description": "ADIF version, e.g. 3.1.7. Defaults to the lab's current version.",
            "in": "query",
            "name": "adif_version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "ADIF version, e.g. 3.1.7. Defaults to the lab's current version.",
              "title": "Adif Version"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Band"
                  },
                  "title": "Response Bands Api V1 Adif Bands Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Bands",
        "tags": [
          "adif"
        ]
      }
    },
